<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Grouping Suite">
    <test name="Grouping Tests">

        <groups>
            <run>
                <include name="functional" />
                <!--exclude name="regression" /> -->
            </run>
        </groups>

        <classes>
            <class name="testng.grouping.LoginTests"/>
            <class name="testng.grouping.SignUpTests"/>
            <class name="testng.grouping.PaymentTests"/>
        </classes>
    </test>
</suite>
